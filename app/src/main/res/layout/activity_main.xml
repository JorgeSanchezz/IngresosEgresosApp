<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#F5F5F5">

    <!-- Tarjetas de Saldos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S. Efectivo"
                android:textSize="12sp"
                android:textColor="#616161" />

            <TextView
                android:id="@+id/tvSaldoEfectivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginHorizontal="2dp"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S. Banco"
                android:textSize="12sp"
                android:textColor="#616161" />

            <TextView
                android:id="@+id/tvSaldoBanco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo Total"
                android:textSize="12sp"
                android:textColor="#616161" />

            <TextView
                android:id="@+id/tvSaldoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barra de Herramientas / Filtro Mes y Año -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="6dp"
        android:layout_marginBottom="8dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Corte: "
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spMesFiltro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spAnioFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnVerGrafica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gráfica"
            android:textSize="12sp"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <!-- Formulario de Entrada de Movimientos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:elevation="2dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnSeleccionarFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-08-12"
                android:textSize="13sp"
                style="?attr/materialButtonOutlinedStyle"/>

            <Spinner
                android:id="@+id/spCuentaInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spCategoriaInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/etConcepto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Concepto (ej. RENTA BARBERIA)"
            android:inputType="textCapCharacters"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etDebe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ingreso ($)"
                android:inputType="numberDecimal"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHaber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Egreso ($)"
                android:inputType="numberDecimal"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnAgregar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardar Movimiento" />

            <Button
                android:id="@+id/btnTransferirMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transferir"
                android:backgroundTint="#7B1FA2"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Barra de acciones rápidas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnGestionCategorias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Categorías"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginEnd="2dp"/>

        <Button
            android:id="@+id/btnAperturaSaldos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saldos Inic."
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginHorizontal="2dp"/>

        <Button
            android:id="@+id/btnExportarExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Excel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginStart="2dp"/>
    </LinearLayout>

    <!-- Tabla Histórica / RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Totales del Pie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="4dp"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Totales Mes -> "
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTotalDebe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="$0.00"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTotalHaber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="$0.00"
            android:textColor="#C62828"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSaldoActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>